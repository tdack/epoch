{
	"name": "epoch",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"cloudflare": {
		"bindings": {
			"DB": {
				"description": "The family trees: people, partnerships, sources and the change log."
			},
			"MEDIA_BUCKET": {
				"description": "Photos and documents attached to records, kept private in your own storage."
			},
			"GEDCOM_IMPORT_QUEUE": {
				"description": "Runs GEDCOM imports in the background. Queues need a **paid Workers plan**."
			}
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --remote -c wrangler.deploy.jsonc",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:backfill:dates": "node scripts/backfill-event-dates.mjs",
		"db:backfill:evidence": "node scripts/backfill-evidence.mjs",
		"db:backfill:fact-details": "node scripts/backfill-fact-details.mjs",
		"db:backfill:notes": "node scripts/backfill-notes.mjs",
		"db:backfill:media-sizes": "node scripts/backfill-media-sizes.mjs",
		"seed": "node scripts/seed.mjs",
		"brand:render": "node scripts/render-brand-assets.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tools/setup",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:eslint": "eslint .",
		"lint:dead": "knip",
		"lint": "npm run format:check && npm run lint:eslint && npm run lint:dead",
		"presetup": "node scripts/ensure-setup-deps.mjs",
		"setup": "node tools/setup/cli.ts",
		"prelint": "node scripts/ensure-setup-deps.mjs",
		"precheck": "node scripts/ensure-setup-deps.mjs",
		"pretest": "node scripts/ensure-setup-deps.mjs",
		"build:worker": "node scripts/deploy-config.mjs && vite build",
		"deploy:worker": "npm run db:migrate && wrangler deploy workers/entry.ts -c wrangler.deploy.jsonc",
		"deploy": "EPOCH_BUTTON_DEPLOY=1 npm run build:worker && npm run deploy:worker",
		"test": "vitest run",
		"test:watch": "vitest",
		"tree:baseline": "RECORD_CROSSING_BASELINE=1 vitest run src/lib/tree-layout/crossings.record.test.ts -u",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@cloudflare/workers-types": "^5.20260911.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0-next.0",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-ease": "^3.0.2",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-transition": "^3.0.9",
		"@types/d3-zoom": "^3.0.9",
		"@types/three": "^0.186.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jsdom": "^29.1.1",
		"knip": "^6.39.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.0.16",
		"vitest": "^5.0.0",
		"wrangler": "^4.131.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.5.2",
		"d3-ease": "^3.0.1",
		"d3-selection": "^3.0.0",
		"d3-transition": "^3.0.1",
		"d3-zoom": "^3.0.0",
		"dejavu-fonts-ttf": "2.37.3",
		"drizzle-orm": "^0.45.2",
		"fflate": "^0.8.3",
		"jspdf": "4.2.1",
		"leaflet": "2.0.0-alpha.1",
		"svg2pdf.js": "2.8.1",
		"three": "^0.186.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
