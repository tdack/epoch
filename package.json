{
	"name": "epoch",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply epoch-genealogy-db --remote",
		"db:migrate:local": "wrangler d1 migrations apply epoch-genealogy-db --local",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run db:migrate && npm run build && wrangler deploy workers/entry.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260911.1",
		"@sveltejs/adapter-auto": "^8.0.0-next.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0-next.0",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3": "^7.4.3",
		"@types/d3-hierarchy": "^3.1.7",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.0",
		"wrangler": "^4.131.1"
	},
	"dependencies": {
		"d3": "^7.9.0",
		"d3-hierarchy": "^3.1.2",
		"drizzle-orm": "^0.45.2",
		"lucide-svelte": "^1.0.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
