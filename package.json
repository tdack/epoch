{
	"name": "epoch",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply epoch-genealogy-db --remote",
		"db:migrate:local": "wrangler d1 migrations apply epoch-genealogy-db --local",
		"db:backfill:dates": "node scripts/backfill-event-dates.mjs",
		"seed": "node scripts/seed.mjs",
		"brand:render": "node scripts/render-brand-assets.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "npm run db:migrate && npm run build && wrangler deploy workers/entry.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"tree:baseline": "RECORD_CROSSING_BASELINE=1 vitest run src/lib/tree-layout/crossings.record.test.ts -u",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@cloudflare/workers-types": "^5.20260911.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^8.0.0-next.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0-next.0",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3": "^7.4.3",
		"@types/d3-hierarchy": "^3.1.7",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^29.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.0",
		"wrangler": "^4.131.1"
	},
	"dependencies": {
		"d3": "^7.9.0",
		"d3-hierarchy": "^3.1.2",
		"drizzle-orm": "^0.45.2",
		"lucide-svelte": "^1.0.1",
		"zod": "^4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
