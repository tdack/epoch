{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "epoch-genealogy",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "epoch-genealogy-db",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "epoch-genealogy-media"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "GEDCOM_IMPORT_QUEUE",
				"queue": "epoch-genealogy-import-queue"
			}
		],
		"consumers": [
			{
				"queue": "epoch-genealogy-import-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 30
			}
		]
	},
	"workflows": [
		{
			"name": "epoch-genealogy-export-workflow",
			"binding": "GEDCOM_EXPORT_WORKFLOW",
			"class_name": "GedcomExportWorkflow",
			"default_retention": {
				"success_retention": "3 days",
				"error_retention": "7 days"
			}
		}
	],
	// Per-location counters with no resource to create: the namespace_id is a number we choose
	// (ADR-066). The limits live in src/lib/server/http/rate-limit.ts; keep the two in step.
	"ratelimits": [
		{
			"name": "UPLOAD_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "IMPORT_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "CSP_REPORT_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["epoch@example.com"]
		}
	],
	"vars": {
		"EPOCH_SOURCE_URL": "https://github.com/tdack/epoch"
	},
	"observability": {
		"logs": {
			"enabled": true
		},
		"issues": {
			"enabled": true
		}
	}
}
